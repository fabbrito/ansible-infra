# Rendered by Ansible (roles/monitoring) — do not edit on host.
# Source: roles/monitoring/templates/env.j2
#
# Read by docker compose for variable interpolation. Secrets ONLY — non-secret
# config sits in the compose, where it stays reviewable.

# Beszel hub first-run admin password (USER_PASSWORD). Box-local, vaulted.
# Asserted non-empty before this renders: an admin-less hub serves without ever
# creating a first user, so the role fails rather than shipping one.
BESZEL_ADMIN_PASSWORD={{ monitoring_admin_password }}
{% if monitoring_agent_paired %}
# Beszel agent registration token, minted by the hub's one-time "Add System" step
# (docs/monitoring/access.md). Vaulted.
BESZEL_AGENT_TOKEN={{ monitoring_agent_token }}
{% endif %}
