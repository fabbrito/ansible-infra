#!/bin/bash
# Rendered by Ansible (roles/docker) — do not edit on host.
# Source: roles/docker/templates/docker-cleanup.sh.j2
# Volumes are NOT touched: we never pass --volumes.
# Two image passes: `system prune -a` (dangling=false) skips fully-untagged
# orphans on the containerd image store; the dangling pass reclaims those.
set -euo pipefail
docker system prune -af --filter "until={{ docker_cleanup_until }}"
docker image prune -f --filter "until={{ docker_cleanup_until }}"
