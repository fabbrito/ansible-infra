#!/usr/bin/env bash
#
# Validate the commit message against AGENTS.md > Commits:
#   type(scope): subject   — scope optional, subject lowercase, no trailing
#                            period.
# A body, when present, is bullet topics ("- ...") or trailers after a blank
# line, never prose — at most 5 bullets, each at most 2 lines of 80 columns.
#
# Every cap here has a matching one on the other axis, because a cap on one
# axis alone is not a cap: bullets are capped in count AND in width, or five
# 400-column bullets satisfy it; trailers are an allowlist, or `Note:` is a
# paragraph with a colon in it. Rejections say what to write instead, because
# a message that only says "too long" is read as an obstacle to route around.
#
# Enable once per clone:  make hooks
# Skip for one commit:    git commit --no-verify
#
# No errexit, per the house Bash style: every rejection is counted in `status`
# so one bad line does not hide the rest of the message.
set -uo pipefail

# AGENTS.md's list exactly. `test` is absent from it deliberately and so is
# absent here: there is no suite to commit against (ADR-0003), so a `test(...)`
# subject means the change is misnamed, not that the list is short.
types='feat|fix|refactor|chore|style|docs|ci|build|perf'

# The trailers git or a reviewer acts on. An allowlist and not a shape, because
# `^Word: ` as a shape is an unlimited prose channel: `Note:`, `Rationale:`,
# `Context:` all satisfy it and none of them are trailers.
trailers='Co-Authored-By|Signed-off-by|Reviewed-by|Refs|Closes|Fixes'

# 72 leaves room for git's 4-column indent in `git log` at 80. Body lines get
# the full 80: a wrapped bullet is already 2 lines, so this caps a topic at
# ~160 columns, which is a topic and not a paragraph.
subject_max=72
body_max=80
bullet_max=5

# Read what the commit will actually record: stop at the --verbose scissors,
# drop git's comment lines, and drop leading blanks so the subject is index 0
# and the blank that must separate a body is index 1. A read loop rather than
# `sed | grep` — two forks for something the shell already does.
lines=()
while IFS= read -r line; do
	[[ $line == '#'*'>8'* ]] && break
	[[ $line == '#'* ]] && continue
	((${#lines[@]} == 0)) && [[ -z ${line//[[:space:]]/} ]] && continue
	lines+=("$line")
done <"$1"

subject=${lines[0]-}

# git writes these itself, or rewrites them later. Not ours to grade.
case $subject in
	'' | 'Merge '* | 'Revert '* | 'fixup!'* | 'squash!'*) exit 0 ;;
esac

status=0

# $1 is what is wrong, $2 is what to write instead. The second is not optional
# in spirit: the rule an author cannot act on is the rule they work around.
reject() {
	printf '\n  %s\n' "$1" >&2
	printf '  → %s\n' "$2" >&2
	status=1
}

# Quoting an offending line back in full is itself the problem being rejected.
snip() {
	((${#1} > 56)) && printf '%s…' "${1:0:56}" || printf '%s' "$1"
}

if [[ $subject =~ ^($types)(\([a-z0-9-]+\))?:\ +(.+)$ ]]; then
	summary=${BASH_REMATCH[3]}

	[[ ${summary:0:1} =~ [[:upper:]] ]] &&
		reject "subject is not lowercase: $(snip "$summary")" \
			'lowercase the first word'
	[[ $summary == *. ]] &&
		reject "subject ends with a period: $(snip "$summary")" \
			'drop the period'
	((${#subject} > subject_max)) &&
		reject "subject is ${#subject} columns, max is $subject_max" \
			'name what changed, not how or why — the body carries those'
else
	reject "header is not 'type(scope): subject': $(snip "$subject")" \
		"type is one of: $types"
fi

((${#lines[@]} > 1)) && [[ -n ${lines[1]//[[:space:]]/} ]] &&
	reject 'the body does not start with a blank line' \
		'put one blank line between the subject and the body'

# Body lines are bullets, wrapped-bullet continuations (indented), or trailers
# (Co-Authored-By:, and nothing else worth naming). Anything else is prose.
#
# The counters are the caps: a message needing more than 5 topics, or a topic
# needing more than 2 lines, is describing how big the change was instead of
# what it did. `open` is the bullet those continuations belong to, so the
# rejection can name it.
bullets=0
wrapped=0
open=''

for ((i = 2; i < ${#lines[@]}; i++)); do
	line=${lines[i]}

	# Session URLs are leakage into permanent shared history — see AGENTS.md.
	if [[ $line == Claude-Session:* ]]; then
		reject 'Claude-Session trailer' 'delete the line'
		continue
	fi

	# Width first, and on every kind of line: without it "at most 2 lines"
	# is satisfied by two lines of any length, which is the whole loophole.
	((${#line} > body_max)) &&
		reject "body line is ${#line} columns, max is $body_max" \
			'cut the line — do not wrap it, the wrap is also capped'

	# A bullet ends at a blank line; a trailer block never opens one.
	if [[ -z ${line//[[:blank:]]/} ]]; then
		open=''
		wrapped=0
		continue
	fi

	if [[ $line =~ ^($trailers):\  ]]; then
		open=''
		wrapped=0
		continue
	fi

	if [[ $line == '- '* ]]; then
		((bullets++))
		open=$line
		wrapped=0
		continue
	fi

	# Indented, and a bullet is open: a wrapped continuation of it.
	if [[ -n $open && $line == [[:blank:]]* ]]; then
		((wrapped++))
		# Once per bullet, not once per overflowing line.
		((wrapped == 2)) &&
			reject "bullet runs past 2 lines: $(snip "$open")" \
				'cut it to one topic, or split the commit'
		continue
	fi

	# Reached by prose, by an unindented continuation, and by a line shaped
	# like a trailer that is not one. Name the last case: it is the one an
	# author invents on purpose.
	reject "body line is not a bullet or a trailer: $(snip "$line")" \
		"write '- topic'; trailers are only: $trailers"
done

((bullets > bullet_max)) &&
	reject "body has $bullets bullets, max is $bullet_max" \
		'drop the bullets that narrate, or split the commit'

# The shape, then the one instruction the caps cannot express: the caps are the
# rule, not an obstacle in front of it. An author who lengthens lines, invents
# trailers, or merges two topics into one bullet has satisfied the hook and
# broken the convention, and only this paragraph says so.
if ((status != 0)); then
	cat >&2 <<-EOF

		  The shape — AGENTS.md > Commits:

		    type(scope): subject   ≤ $subject_max cols, lowercase, no period

		    - topic                ≤ $bullet_max bullets, ≤ 2 lines, ≤ $body_max cols
		      wrapped continuation

		    Co-Authored-By: ...    trailers last

		  A body is optional and usually wrong; subject-only is the default. If
		  it does not fit, the commit is too big or the body is narrating —
		  split it or cut it. Do not widen lines, invent trailers, or pack two
		  topics into one bullet to get under a cap; that passes the hook and
		  breaks the convention it is enforcing.

		  Deliberate exception: git commit --no-verify

	EOF
fi

exit $status
