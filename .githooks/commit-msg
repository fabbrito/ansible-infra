#!/usr/bin/env bash
#
# Grades the commit message against AGENTS.md > Commits. The shape it wants is
# printed on rejection, at the bottom of this file.
#
# Enable once per clone:  make hooks
# Skip for one commit:    git commit --no-verify
#
# No errexit: every rejection is counted, so one bad line does not hide the
# rest of the message.
set -uo pipefail

types='feat|fix|refactor|chore|style|docs|test|ci|build|perf'

# An allowlist, not a shape: `^Word: ` would make `Note:` a prose channel.
# Shown in rejections; the match is the case below.
trailers='Co-Authored-By|Signed-off-by|Reviewed-by|Refs|Closes|Fixes'

# 72 leaves room for git's 4-column indent in `git log` at 80. Capped on both
# axes: count alone lets five 400-column bullets through.
subject_max=72
body_max=80
bullet_max=5

# Stop at the --verbose scissors, drop git's comments and leading blanks, so
# the subject is index 0 and the body's blank separator is index 1.
#
# An editor's message arrives raw, unlike -m/-F: grade what git will record.
# A CR or trailing space hid a period, and an unterminated last line was
# never read.
lines=()
while IFS= read -r line || [[ -n $line ]]; do
	line=${line%"${line##*[![:space:]]}"}
	[[ $line == '#'*'>8'* ]] && break
	[[ $line == '#'* ]] && continue
	((${#lines[@]} == 0)) && [[ -z ${line//[[:space:]]/} ]] && continue
	lines+=("$line")
done <"$1"

subject=${lines[0]-}

# git writes these itself, or rewrites them later. Not ours to grade.
case $subject in
	'' | 'Merge '* | 'Revert '* | 'fixup!'* | 'squash!'* | 'amend!'*) exit 0 ;;
esac

status=0

# $1 what is wrong, $2 what to write instead. The rule an author cannot act on
# is the rule they work around.
reject() {
	printf '\n  %s\n' "$1" >&2
	printf '  → %s\n' "$2" >&2
	status=1
}

# Quoting an offending line back in full is itself the problem being rejected.
snip() {
	((${#1} > 56)) && printf '%s…' "${1:0:56}" || printf '%s' "$1"
}

# One space, then a word: `fix:   ` is otherwise a subject.
if [[ $subject =~ ^($types)(\([a-z0-9-]+\))?:\ ([^[:space:]].*)$ ]]; then
	summary=${BASH_REMATCH[3]}

	[[ ${summary:0:1} =~ [[:upper:]] ]] &&
		reject "subject is not lowercase: $(snip "$summary")" \
			'lowercase the first word'
	[[ $summary == *. ]] &&
		reject "subject ends with a period: $(snip "$summary")" \
			'drop the period'
	((${#subject} > subject_max)) &&
		reject "subject is ${#subject} columns, max is $subject_max" \
			'name what changed, not how or why — the body carries those'
else
	reject "header is not 'type(scope): subject': $(snip "$subject")" \
		"type is one of: $types"
fi

((${#lines[@]} > 1)) && [[ -n ${lines[1]//[[:space:]]/} ]] &&
	reject 'the body does not start with a blank line' \
		'put one blank line between the subject and the body'

# Bullets, indented continuations, or trailers. Anything else is prose.
# `open` is the bullet a continuation belongs to, so the rejection can name it.
bullets=0
wrapped=0
open=''
seen_trailer=false
# In a variable: `<` inside [[ ]] parses as an operator.
person='^[^<>]+ <[^<> ]+>$'

for ((i = 2; i < ${#lines[@]}; i++)); do
	line=${lines[i]}

	# Width first, on every line kind: "at most 2 lines" alone is satisfied
	# by two lines of any length.
	((${#line} > body_max)) &&
		reject "body line is ${#line} columns, max is $body_max" \
			'cut the line — do not wrap it, the wrap is also capped'

	# A bullet ends at a blank line.
	if [[ -z ${line//[[:blank:]]/} ]]; then
		open=''
		wrapped=0
		continue
	fi

	# Keys case-folded, as git reads them. Values have a shape, or a trailer
	# carries prose.
	if [[ $line =~ ^([A-Za-z-]+):\ (.*)$ ]]; then
		value=${BASH_REMATCH[2]}
		key=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')
		seen_trailer=true
		case $key in
			co-authored-by | signed-off-by | reviewed-by)
				[[ $value =~ $person ]] ||
					reject "trailer is not 'Name <email>': $(snip "$line")" \
						'one person per trailer'
				;;
			refs | closes | fixes)
				[[ $value =~ ^[^[:space:]]+$ ]] ||
					reject "trailer is not one reference: $(snip "$line")" \
						'one #issue or URL per trailer'
				;;
			*)
				reject "unknown trailer: $(snip "$line")" \
					"trailers are only: $trailers"
				;;
		esac
		continue
	fi

	if $seen_trailer; then
		reject "trailers are not last: $(snip "$line")" \
			'move the trailers below the body'
		continue
	fi

	if [[ $line == '- '* ]]; then
		((bullets++))
		open=$line
		wrapped=0
		continue
	fi

	# Indented, and a bullet is open: a wrapped continuation of it.
	if [[ -n $open && $line == [[:blank:]]* ]]; then
		((wrapped++))
		# Once per bullet, not once per overflowing line.
		((wrapped == 2)) &&
			reject "bullet runs past 2 lines: $(snip "$open")" \
				'cut it to one topic, or split the commit'
		continue
	fi

	reject "body line is not a bullet or a trailer: $(snip "$line")" \
		"write '- topic'; trailers are only: $trailers"
done

((bullets > bullet_max)) &&
	reject "body has $bullets bullets, max is $bullet_max" \
		'drop the bullets that narrate, or split the commit'

if ((status != 0)); then
	cat >&2 <<-EOF

		  The shape — AGENTS.md > Commits:

		    type(scope): subject   ≤ $subject_max cols, lowercase, no period

		    - topic                ≤ $bullet_max bullets, ≤ 2 lines, ≤ $body_max cols
		      wrapped continuation

		    Co-Authored-By: ...    trailers last

		  A body is optional and usually wrong; subject-only is the default.
		  If it does not fit, the commit is too big or the body is narrating.
		  Widening lines, inventing trailers or packing two topics into one
		  bullet passes the hook and breaks the convention it enforces.

		  Deliberate exception: git commit --no-verify

	EOF
fi

exit $status
