#!/usr/bin/env bash
#
# Runs `make check` before the commit lands. AGENTS.md asks every commit be
# green, not just the tip; only a hook can enforce that.
#
# Enable once per clone:  make hooks
# Skip for one commit:    git commit --no-verify
#
# Grades the working tree, not the index: prettier and ansible-lint read from
# disk. The secret guard below is the exception and reads the index on purpose.
#
# No errexit: failures are counted, so the guard and the gate each report.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

staged=()
while IFS= read -r file; do
	staged+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACMR)
((${#staged[@]} == 0)) && exit 0

status=0

# $1 the file, $2 the rule that refused it. A guard that only says "rejected"
# gets renamed around rather than obeyed.
reject() {
	printf '\n  %s\n' "$1" >&2
	printf '  → %s\n' "$2" >&2
	status=1
}

# Secrets first, and this hard-stops: a credential is permanent once committed.
# Rejects outright rather than grading. There is no vault here to encrypt
# (AGENTS.md > Secrets), so an encrypted one is as wrong as a plain one, and
# keys and certificates belong to a fleet. Names are case-folded and matched on
# prefix as well as suffix: `.PEM`, `.vault_pass.txt` and a bare `id_ed25519`
# all defeated the suffix-only list this replaced. The content scan is the real
# defence.
for file in "${staged[@]}"; do
	name=${file##*/}
	# tr, not ${name,,}: the bash 4 form is a fatal expansion error under
	# bash 3.2, which kills the hook before the content scan below runs.
	name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')

	case $name in
		.vault_pass* | vault.y*ml | *.vault.y*ml | *vault_pass*)
			reject "$file" \
				'this repo holds no vault — AGENTS.md > Secrets'
			continue
			;;
		*.key | *.pem | *.crt | *.cer | *.der | *.p12 | *.pfx | *.jks | \
			*.p8 | *.asc | *.gpg | *.ppk | id_rsa* | id_dsa* | \
			id_ecdsa* | id_ed25519*)
			reject "$file" \
				'key or certificate material belongs to a fleet'
			continue
			;;
		.env | .env.* | *.env)
			reject "$file" \
				'an env file carries a consumer credential'
			continue
			;;
	esac

	# Content, not name. Read from the index, which is what the commit
	# records. `grep -I` treats a binary blob as a non-match. Patterns are
	# bracket-broken ([E], [$]) so this file does not match itself. Do not
	# "tidy" them.
	if git show ":$file" 2>/dev/null |
		grep -Iq -E -e 'BEGIN [A-Z ]*PRIVATE KE[Y]' \
			-e 'BEGIN CERTIFICAT[E]' \
			-e 'PRIVATE KEY BLOC[K]' \
			-e '[$]ANSIBLE_VAULT;' \
			-e 'AKIA[0-9A-Z]{16}'; then
		reject "$file" \
			'contains key, certificate or vault material — not the name, the bytes'
	fi
done

if ((status != 0)); then
	cat >&2 <<-'EOF'

		  Nothing was committed. Renaming will not help: the guard reads the
		  staged bytes too. There is no vault here, so an encrypted secret is
		  as wrong as a plain one. It belongs in the consuming repo.

		  git restore --staged <file>

	EOF
	exit 1
fi

printf '==> %s\n' 'make check'
make check || status=1

# `--no-verify` is named once, and last: an escape from a broken hook, not a
# peer option to fixing the tree.
if ((status != 0)); then
	cat >&2 <<-'EOF'

		  The gate is red, so this commit would break "green between commits"
		  (AGENTS.md > Commits). A red commit mid-branch is a revert that
		  does not build.

		    make fmt      formatting failures fix themselves
		    make check    re-run the gate

		  Scope the commit down if the failure is in unfinished work.
		  --no-verify is for a broken hook, not a gate telling you something.

	EOF
fi

exit $status
