{
  "markdown": { "lineWidth": 120, "textWrap": "always" },
  "json": { "lineWidth": 120 },
  "toml": { "lineWidth": 120, "indentWidth": 4 },
  "yaml": { "printWidth": 120 },
  "includes": ["**/*.md", "**/*.json", "**/*.toml", "**/*.{yml,yaml}"],
  "excludes": [".collections", "tests/golden/expected", "CLAUDE.md", ".git"],
  "plugins": [
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
