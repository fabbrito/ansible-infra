# Ansible
*.retry
# `make deps` installs here, scripts/lint.sh symlinks this collection in
# alongside them, and `make build` drops the tarball here too.
.collections/
# per-project runtime cache created by ansible-lint / ansible-compat
.ansible/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ruff_cache/

# Node / Bun
node_modules/
.bun/

# Secrets. This repo holds none — AGENTS.md > Secrets — so nothing here
# needs one of these; `git add .` sweeping one in is the mistake to stop.
.vault_pass*
vault.y*ml
*.vault.y*ml
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/
Thumbs.db

# Local scratch
/tmp/
/.tmp/
/scratch/
*.log

docs/plan_*.md
