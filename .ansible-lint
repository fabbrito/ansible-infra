# Per-repo lint config. Run by the `ansible` hook lane (scripts/lint.sh).
# Production profile, no skip_list — we comply in full. A rule skipped here is
# not our problem to live with: this layer is converged by teams who did not
# write it, so the surprise lands on their fleet.
profile: production

# This repo's rules, beside the defaults. A profile unloads every rule it does
# not list, so each one is named in enable_list too.
rulesdir:
  - .config/ansible-lint/
use_default_rules: true
enable_list:
  - assert-that-string

# Not Ansible: lefthook's config, whose job lines outrun yaml[line-length].
exclude_paths:
  - lefthook.yml
  - .config/
