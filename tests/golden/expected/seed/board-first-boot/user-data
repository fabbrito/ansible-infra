#cloud-config
# Rendered by Ansible — do not edit on host.
# Source: fabbrito.infra collection — roles/seed/templates/user-data.j2
#
# A key whose module the image's cloud.cfg does not run is ignored without a
# warning.
hostname: board-a
# Without it sudo warns "unable to resolve host".
manage_etc_hosts: true
# Merges over the image's default_user, which keeps groups and shell. sudo is
# restated because Ansible needs it and a seed can strip it (Imager writes
# `sudo: null`). No password: the card is the way back in.
user:
  name: operator
  lock_passwd: true
  sudo: ALL=(ALL) NOPASSWD:ALL
  ssh_authorized_keys:
    - "ssh-ed25519 AAAAgolden-fixture-not-a-key operator@example"
ssh_pwauth: false
runcmd:
  # Raspberry Pi OS Lite ships SSH disabled.
  - [systemctl, enable, --now, ssh]
