# No `acl`: R2 object read/write tokens deny PutObjectAcl, so an ACL header 403s.
# `no_check_bucket`: bucket-scoped tokens cannot list buckets.
[r2]
type = s3
provider = Cloudflare
access_key_id = golden-fixture-not-a-key-id
secret_access_key = golden-fixture-not-a-secret
endpoint = https://golden-fixture.r2.example
no_check_bucket = true

# Plain directory names keep R2 lifecycle prefix rules matching. Lose these
# passwords and the backups are unrecoverable.
[r2crypt]
type = crypt
remote = r2:golden-bucket
password = golden-fixture-not-a-password
password2 = golden-fixture-not-a-salt
filename_encryption = standard
directory_name_encryption = false
