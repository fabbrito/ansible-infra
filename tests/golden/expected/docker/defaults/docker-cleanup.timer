# Rendered by Ansible — do not edit on host.
# Source: fabbrito.infra collection — roles/docker/templates/docker-cleanup.timer.j2
[Unit]
Description=Docker system prune timer (localhost)

[Timer]
OnCalendar=Sun *-*-* 05:00:00
RandomizedDelaySec=30m
# Re-run a missed prune as soon as the host is back up (cron would skip it).
Persistent=true
Unit=docker-cleanup.service

[Install]
WantedBy=timers.target
