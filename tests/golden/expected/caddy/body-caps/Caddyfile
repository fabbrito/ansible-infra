# Rendered by Ansible — do not edit on host.
# Source: fabbrito.infra collection — roles/caddy/templates/Caddyfile.j2
{
	# fabbrito.infra ADR-0006: the email admits ZeroSSL as a fallback
	# issuer. Absent, Caddy's chain silently shrinks to Let's Encrypt alone.
	# The role asserts it rather than render empty.
	email ops@example.org
}

app.example.org {
	# No `tls` line: automatic HTTPS over HTTP-01 (fabbrito.infra ADR-0006).
	# Emitting one unconditionally, at a default.pem no ACME host writes,
	# stopped an ACME-only host converging at all.
	# The debian package owns /var/log/caddy as caddy:caddy; tasks/main.yml
	# pre-creates each file caddy-owned so a root-run `caddy validate` cannot
	# claim it first.
	log {
		output file /var/log/caddy/app.example.org.log {
			roll_size 10mb
			roll_keep 5
		}
	}
	encode zstd gzip
	@body1 path /api/auth/*
	request_body @body1 {
		max_size 64KB
	}
	@body2 path /api/v1/upload /api/v1/upload/*
	request_body @body2 {
		max_size 25MiB
	}
	# THE NEGATED MATCHER IS LOAD-BEARING. Measured on caddy 2.8.0: request_body
	# handlers COMPOSE — each wraps the body reader, so the SMALLEST limit wins
	# and source order changes nothing. A bare matcher-less `request_body` clamps
	# every cap above to 1MB, validates clean, and 413s an upload
	# the app accepts.
	@body_default not path /api/auth/* /api/v1/upload /api/v1/upload/*
	request_body @body_default {
		max_size 1MB
	}
	@upstream1 path /api/* /webhooks/* /health
	handle @upstream1 {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up CF-Connecting-IP {client_ip}
			transport http {
				dial_timeout 10s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
	# The matcher-less `handle` is the catch-all: `handle` blocks sort by matcher
	# SPECIFICITY, not source order, which is what makes this fall last.
	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-For {client_ip}
			header_up CF-Connecting-IP {client_ip}
			transport http {
				dial_timeout 10s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
}
